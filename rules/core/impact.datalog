reachable[node] := start[node]
reachable[from] :=
    traversed_edge[from, _, _, _, _, _]

traversed_edge[from, to, relation, evidence, confidence, provenance] :=
    reachable[to],
    direct[from, to, relation, evidence, confidence, provenance]

traversed_edge[from, to, relation, evidence, confidence, provenance] :=
    reachable[from],
    direct[from, to, relation, evidence, confidence, provenance],
    relation = 'implemented_by',
    starts_with(from, 'grpc://')

selected_edge[from, to, relation, evidence, confidence, provenance] :=
    traversed_edge[from, to, relation, evidence, confidence, provenance]
