structural_relation[relation] <- [
    ['defines'], ['field_of'], ['request_type'], ['response_type']
]

selected_state[state] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_state{view: $view, revision, state}

?[direction, relation, related, evidence, confidence, provenance] :=
    selected_state[state],
    *state_observation{state, from: $entity, relation, to: related, evidence},
    *state_observation_metadata{
        state,
        from: $entity,
        relation,
        to: related,
        confidence,
        provenance,
    },
    structural_relation[relation],
    direction = 'outgoing'

?[direction, relation, related, evidence, confidence, provenance] :=
    selected_state[state],
    *state_observation:by_to{state, from: related, relation, to: $entity, evidence},
    *state_observation_metadata:by_to{
        state,
        from: related,
        relation,
        to: $entity,
        confidence,
        provenance,
    },
    structural_relation[relation],
    direction = 'incoming'

:order direction, relation, related
:reorder written
