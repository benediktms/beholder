structural_relation[relation] <- [
    ['defines'], ['field_of'], ['request_type'], ['response_type']
]

?[direction, relation, related, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{
        view: $view,
        revision,
        from: $entity,
        relation,
        to: related,
        evidence,
        confidence,
        provenance,
    },
    structural_relation[relation],
    direction = 'outgoing'

?[direction, relation, related, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation:by_to{
        view: $view,
        revision,
        from: related,
        relation,
        to: $entity,
        evidence,
        confidence,
        provenance,
    },
    structural_relation[relation],
    direction = 'incoming'

:order direction, relation, related
:reorder written
