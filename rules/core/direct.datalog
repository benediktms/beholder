selected_state[state] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_state{view: $view, revision, state}

selected_shard[producer, owner, version] :=
    *analysis_fact_shard_selection{view: $view, producer, owner, version}

selected_enrichment[owner, repository, analyzer, version, input_fingerprint] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_repository_enrichment{
        view: $view,
        revision,
        owner,
        repository,
        analyzer,
        version,
        input_fingerprint,
    }

baseline_entity[id] := selected_state[state], *state_entity{state, id}

baseline_entity[id] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_entity{producer, owner, version, id}

baseline_entity[id] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_entity{view: $view, revision, id}

enrichment_entity[id, kind, metadata] :=
    *analysis_enrichment_entity_selection{view: $view, id, owner},
    selected_enrichment[owner, _, _, _, _],
    *enrichment_entity_contribution{view: $view, owner, id, kind, metadata}

baseline_observation[from, relation, to, evidence] :=
    selected_state[state],
    *state_observation{state, from, relation, to, evidence}

baseline_observation[from, relation, to, evidence] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_observation{producer, owner, version, from, relation, to, evidence}

baseline_observation[from, relation, to, evidence] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{view: $view, revision, from, relation, to, evidence}

enrichment_observation[from, relation, to, evidence, confidence, provenance] :=
    *analysis_enrichment_observation_selection{
        view: $view,
        from,
        relation,
        to,
        evidence,
        owner,
    },
    selected_enrichment[owner, _, _, _, _],
    *enrichment_observation_contribution{
        view: $view,
        owner,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    }

base_dependency_override[
    from, relation, unresolved_to, resolved_to, evidence, confidence, provenance,
] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_dependency_override{
        view: $view,
        revision,
        from,
        relation,
        unresolved_to,
        resolved_to,
        evidence,
    },
    *analysis_revision_dependency_override_metadata{
        view: $view,
        revision,
        from,
        relation,
        unresolved_to,
        confidence,
        provenance,
    }

enrichment_dependency_override[
    from,
    relation,
    unresolved_to,
    resolved_to,
    evidence,
    confidence,
    provenance,
] :=
    *analysis_enrichment_override_selection{
        view: $view,
        from,
        relation,
        unresolved_to,
        owner,
    },
    selected_enrichment[owner, _, _, _, _],
    *enrichment_override_contribution{
        view: $view,
        owner,
        from,
        relation,
        unresolved_to,
        resolved_to,
        evidence,
        confidence,
        provenance,
    }

dependency_override[from, relation, unresolved_to, resolved_to, evidence, confidence, provenance] :=
    base_dependency_override[
        from, relation, unresolved_to, resolved_to, evidence, confidence, provenance,
    ]

dependency_override[from, relation, unresolved_to, resolved_to, evidence, confidence, provenance] :=
    enrichment_dependency_override[
        from, relation, unresolved_to, resolved_to, evidence, confidence, provenance,
    ],
    not base_dependency_override[from, relation, unresolved_to, _, _, _, _]

overridden[from, relation, unresolved_to, evidence] :=
    baseline_observation[from, relation, unresolved_to, evidence],
    dependency_override[from, relation, unresolved_to, _, _, _, _]

base_overridden[from, relation, unresolved_to, evidence] :=
    baseline_observation[from, relation, unresolved_to, evidence],
    base_dependency_override[from, relation, unresolved_to, _, _, _, _]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_state[state],
    *state_observation{state, from, relation, to, evidence},
    *state_observation_metadata{state, from, relation, to, confidence, provenance},
    not base_overridden[from, relation, to, evidence]

base_effective_observation[from, resolved_to, relation, evidence, confidence, provenance] :=
    base_dependency_override[
        from, relation, _, resolved_to, evidence, confidence, provenance,
    ]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_observation{
        producer,
        owner,
        version,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    },
    not base_overridden[from, relation, to, evidence]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{
        view: $view,
        revision,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    }

effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_state[state],
    *state_observation{state, from, relation, to, evidence},
    *state_observation_metadata{state, from, relation, to, confidence, provenance},
    not overridden[from, relation, to, evidence]

effective_observation[from, resolved_to, relation, evidence, confidence, provenance] :=
    baseline_observation[from, relation, unresolved_to, evidence],
    dependency_override[
        from, relation, unresolved_to, resolved_to, _, confidence, provenance,
    ]

effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_observation{
        producer,
        owner,
        version,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    },
    not overridden[from, relation, to, evidence]

effective_observation[from, to, relation, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{
        view: $view,
        revision,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    }

effective_observation[from, to, relation, evidence, confidence, provenance] :=
    enrichment_observation[from, relation, to, evidence, confidence, provenance],
    not baseline_observation[from, relation, to, evidence],
    not overridden[from, relation, to, evidence]

base_direct[from, to, relation, evidence, confidence, provenance] :=
    selected_state[state],
    *state_dependency_observation{state, from, relation, to, evidence},
    *state_observation_metadata{state, from, relation, to, confidence, provenance},
    not overridden[from, relation, to, evidence]

base_direct[from, resolved_to, relation, evidence, confidence, provenance] :=
    base_dependency_override[from, relation, _, resolved_to, evidence, confidence, provenance]

base_direct[from, to, relation, evidence, confidence, provenance] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_dependency_observation{
        producer, owner, version, from, relation, to, evidence,
    },
    *analysis_fact_shard_observation{
        producer,
        owner,
        version,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    },
    not overridden[from, relation, to, evidence]

base_direct[from, to, relation, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{
        view: $view,
        revision,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    }

direct[from, to, relation, evidence, confidence, provenance] :=
    base_direct[from, to, relation, evidence, confidence, provenance]

direct[from, resolved_to, relation, evidence, confidence, provenance] :=
    baseline_observation[from, relation, unresolved_to, evidence],
    enrichment_dependency_override[
        from, relation, unresolved_to, resolved_to, _, confidence, provenance,
    ],
    not base_dependency_override[from, relation, _, _, _, _, _]

direct[from, to, relation, evidence, confidence, provenance] :=
    enrichment_observation[from, relation, to, evidence, confidence, provenance],
    not baseline_observation[from, relation, to, evidence],
    not overridden[from, relation, to, evidence]

base_direct_pair[from, to] :=
    selected_state[state],
    *state_dependency_observation{state, from, relation, to, evidence},
    not overridden[from, relation, to, evidence]

base_direct_pair[from, resolved_to] :=
    base_dependency_override[from, _, _, resolved_to, _, _, _]

base_direct_pair[from, to] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_dependency_observation{producer, owner, version, from, to}

base_direct_pair[from, to] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{view: $view, revision, from, to}

direct_pair[from, to] := base_direct_pair[from, to]

direct_pair[from, resolved_to] :=
    baseline_observation[from, relation, unresolved_to, _],
    enrichment_dependency_override[
        from, relation, unresolved_to, resolved_to, _, _, _,
    ],
    not base_dependency_override[from, _, _, _, _, _, _]

direct_pair[from, to] :=
    enrichment_observation[from, relation, to, evidence, _, _],
    not baseline_observation[from, relation, to, evidence],
    not overridden[from, relation, to, evidence]

enrichment_diagnostic[repository, code, severity, path, line, detail] :=
    *analysis_enrichment_diagnostic_selection{
        view: $view,
        repository,
        code,
        severity,
        path,
        line,
        owner,
    },
    selected_enrichment[owner, repository, _, _, _],
    *enrichment_diagnostic_contribution{
        view: $view,
        owner,
        repository,
        code,
        severity,
        path,
        line,
        detail,
    }

selected_diagnostic_replacement[repository, code] :=
    selected_enrichment[owner, repository, _, _, _],
    *enrichment_diagnostic_replacement{
        view: $view,
        owner,
        repository,
        code,
    }
