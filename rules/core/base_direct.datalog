selected_state[state] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_state{view: $view, revision, state}

selected_shard[producer, owner, version] :=
    *analysis_fact_shard_selection{view: $view, producer, owner, version}

base_dependency_override[
    from, relation, unresolved_to, resolved_to, evidence, confidence, provenance,
] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_dependency_override{
        view: $view,
        revision,
        from,
        relation,
        unresolved_to,
        resolved_to,
        evidence,
    },
    *analysis_revision_dependency_override_metadata{
        view: $view,
        revision,
        from,
        relation,
        unresolved_to,
        confidence,
        provenance,
    }

base_overridden[from, relation, unresolved_to, evidence] :=
    base_dependency_override[from, relation, unresolved_to, _, evidence, _, _]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_state[state],
    *state_observation{state, from, relation, to, evidence},
    *state_observation_metadata{state, from, relation, to, confidence, provenance},
    not base_overridden[from, relation, to, evidence]

base_effective_observation[from, resolved_to, relation, evidence, confidence, provenance] :=
    base_dependency_override[
        from, relation, _, resolved_to, evidence, confidence, provenance,
    ]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    selected_shard[producer, owner, version],
    *analysis_fact_shard_observation{
        producer,
        owner,
        version,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    },
    not base_overridden[from, relation, to, evidence]

base_effective_observation[from, to, relation, evidence, confidence, provenance] :=
    *analysis_revision{view: $view, revision},
    *analysis_revision_observation{
        view: $view,
        revision,
        from,
        relation,
        to,
        evidence,
        confidence,
        provenance,
    }
